{
  "project": {
    "linux": false
  },
  "quality": {
    "paths": [
      "Sources"
    ],
    "include": [
      "/Package.swift",
      "Sources/**",
      "Tests/LitmusCoreTests/*.swift"
    ],
    "exclude": [
      "Tests/Fixtures/**"
    ]
  },
  "release": {
    "executables": [
      "litmus"
    ]
  },
  "commands": [
    {
      "id": "smoke",
      "run": "swift build --product litmus && BIN=\"$(swift build --show-bin-path)/litmus\" && TOOLCHAINS=swift LITMUS_BIN=\"$BIN\" scripts/smoke.sh",
      "cadence": [
        "nightly",
        "tag",
        "dispatch"
      ],
      "os": "macOS",
      "title": "Integration · Mutation Smoke"
    }
  ],
  "swift": {
    "versions": [
      "6.4.2"
    ]
  }
}
