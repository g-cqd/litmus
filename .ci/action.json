{
  "project": {
    "linux": false
  },
  "quality": {
    "paths": [
      "Sources"
    ],
    "include": [
      "Package.swift",
      "Sources/**",
      "Tests/LitmusCoreTests/*.swift"
    ],
    "exclude": [
      "Tests/Fixtures/**"
    ]
  },
  "release": {
    "executables": [
      "litmus"
    ]
  },
  "commands": [
    {
      "id": "smoke",
      "run": "export TOOLCHAINS=swift; swift build --product litmus && LITMUS_BIN=\"$(swift build --show-bin-path)/litmus\" scripts/smoke.sh",
      "cadence": [
        "nightly",
        "tag",
        "dispatch"
      ],
      "os": "macOS"
    }
  ],
  "swift": {
    "versions": [
      "6.4.2"
    ],
    "environment": {
      "TOOLCHAINS": "swift"
    }
  }
}
